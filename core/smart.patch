+	current := r.cumulRetrans.Load()
+	if current > math.MaxInt64/2-v {
+		r.cumulSent.Store(r.cumulSent.Load() / 2)
+		r.cumulRetrans.Store(current / 2)
+	} else {
+		r.cumulRetrans.Add(v)
+	}
+}
