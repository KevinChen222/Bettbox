+
+func TestSmartFirstWriteCloseOnce(t *testing.T) {
+	want := errors.New("transport close error")
+	leaf := &callbackTestConn{err: want}
+	conn := NewFirstWriteCallBackConn(leaf, func(error) {})
+	var workers sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			if err := conn.Close(); err != want {
+				t.Errorf("lost original error: %v", err)
+			}
+		}()
+	}
+	workers.Wait()
+	if got := leaf.closes.Load(); got != 1 {
+		t.Fatalf("Close reached transport %d times", got)
+	}
+}
+
+func TestSmartTransferErrorObserver(t *testing.T) {
+	leaf := &callbackTestConn{}
+	var readErr, writeErr atomic.TypedValue[error]
+	conn := NewErrorCallBackConn(leaf, &readErr, &writeErr)
+	for _, ignored := range []error{nil, net.ErrClosed, os.ErrDeadlineExceeded} {
+		leaf.err = ignored
+		if _, err := conn.Read(nil); err != ignored {
+			t.Fatal("Read changed the result")
+		}
+		if err := conn.WriteBuffer(nil); err != ignored {
+			t.Fatal("WriteBuffer changed the result")
+		}
+	}
+	if readErr.Load() != nil || writeErr.Load() != nil {
+		t.Fatal("lifecycle error charged to node")
+	}
+	first := errors.New("mid-transfer failure")
+	leaf.err = first
+	_ = conn.ReadBuffer(nil)
+	_, _ = conn.Write(nil)
+	leaf.err = errors.New("later failure")
+	_, _ = conn.Read(nil)
+	_ = conn.WriteBuffer(nil)
+	if readErr.Load() != first || writeErr.Load() != first {
+		t.Fatal("first transfer error was lost")
+	}
+	if _, ok := conn.(interface{ ReaderReplaceable() bool }); ok {
+		t.Fatal("observer can be peeled by reader")
+	}
+	if _, ok := conn.(interface{ WriterReplaceable() bool }); ok {
+		t.Fatal("observer can be peeled by writer")
+	}
+}
