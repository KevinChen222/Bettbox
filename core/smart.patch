+func (s *Smart) Unwrap(metadata *C.Metadata, touch bool) C.Proxy {
+	proxies := s.GetProxies(touch)
+
+	if metadata == nil {
+		return proxies[0]
+	}
+
+	if s.selected != "" {
+		for _, p := range proxies {
+			if p.Name() == s.selected {
+				return p
+			}
+		}
+	}
+
+	proxies, _, _ = s.selectProxies(metadata, proxies)
+
+	return proxies[0]
+}
