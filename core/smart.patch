+)
+
+type closeTestConn struct {
+	closes  atomic.Int32
+	closeFn func() error
+}
+
+func (c *closeTestConn) Read([]byte) (int, error)         { return 0, io.EOF }
+func (c *closeTestConn) Write(p []byte) (int, error)      { return len(p), nil }
+func (c *closeTestConn) LocalAddr() net.Addr              { return &net.TCPAddr{} }
+func (c *closeTestConn) RemoteAddr() net.Addr             { return &net.TCPAddr{Port: 443} }
+func (c *closeTestConn) SetDeadline(time.Time) error      { return nil }
+func (c *closeTestConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *closeTestConn) SetWriteDeadline(time.Time) error { return nil }
+func (c *closeTestConn) Close() error {
+	c.closes.Add(1)
+	if c.closeFn != nil {
+		return c.closeFn()
+	}
+	return nil
+}
+
+func closeTestAdapter() *outbound.Base {
+	return outbound.NewBase(outbound.BaseOption{Name: "close-test", Addr: "127.0.0.1:443", Type: C.Shadowsocks})
+}
+
+func TestTCPTrackerCloseSS2022Chain(t *testing.T) {
+	method, err := shadowaead_2022.NewMethod("2022-blake3-aes-128-gcm", cipher.MethodOptions{KeyList: [][]byte{make([]byte, 16)}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, depth := range []int{1, 4, 18} {
+		t.Run(fmt.Sprint(depth), func(t *testing.T) {
+			manager := &statistic.Manager{}
+			leaf := &closeTestConn{}
+			var conn net.Conn = leaf
+			var trackers []statistic.Tracker
+			for i := 0; i < depth; i++ {
+				// DialConn initializes the real SS2022 writer, whose Upstream
+				// makes clientConn.Close revisit the underlying tracker.
+				ss, err := method.DialConn(conn, M.Socksaddr{Fqdn: "example.test", Port: 443})
+				if err != nil {
+					t.Fatal(err)
+				}
+				wrapped := outbound.NewConn(ss, closeTestAdapter())
+				wrapped.(interface{ AddRef(any) }).AddRef(method)
+				wrapped = callback.NewFirstWriteCallBackConn(wrapped, func(error) {})
+				tracker := statistic.NewTCPTracker(wrapped, manager, &C.Metadata{SmartTarget: "close-test"}, nil, 0, 0, false)
+				trackers = append(trackers, tracker)
+				conn = tracker
+			}
+			start := time.Now()
+			if err := conn.Close(); err != nil {
+				t.Fatal(err)
+			}
+			t.Logf("depth=%d leaf closes=%d duration=%s", depth, leaf.closes.Load(), time.Since(start))
+			// The innermost SS2022 wrapper closes its raw transport twice;
+			// every tracker must prevent this from multiplying at each layer.
+			if got := leaf.closes.Load(); got != 2 {
+				t.Errorf("transport closed %d times, want 2 independent of depth", got)
+			}
+			for _, tracker := range trackers {
+				if manager.Get(tracker.ID()) != nil {
+					t.Errorf("tracker %s was not removed", tracker.ID())
+				}
+				if err := tracker.Close(); err != nil {
+					t.Fatal(err)
+				}
+			}
+			manager.RangeSmartTarget("close-test", func(string) bool { t.Error("Smart target membership remains after close"); return true })
+			if got := leaf.closes.Load(); got != 2 {
+				t.Errorf("repeated close reached transport: %d", got)
+			}
+		})
+	}
+}
+
+func TestTCPTrackerCloseReentrant(t *testing.T) {
+	manager := &statistic.Manager{}
+	leaf := &closeTestConn{}
+	wrapped := callback.NewFirstWriteCallBackConn(outbound.NewConn(leaf, closeTestAdapter()), func(error) {})
+	tracker := statistic.NewTCPTracker(wrapped, manager, &C.Metadata{}, nil, 0, 0, false)
+	leaf.closeFn = func() error {
+		// Bound the old implementation's recursion so regression failure is safe.
+		if leaf.closes.Load() == 1 {
+			return tracker.Close()
+		}
+		return nil
+	}
+	if err := tracker.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if got := leaf.closes.Load(); got != 1 {
+		t.Errorf("reentrant close reached transport %d times", got)
+	}
+	if manager.Get(tracker.ID()) != nil {
+		t.Fatal("tracker was not removed")
+	}
+}
+
+func TestTCPTrackerCloseUnblocksSS2022Read(t *testing.T) {
+	method, err := shadowaead_2022.NewMethod("2022-blake3-aes-128-gcm", cipher.MethodOptions{KeyList: [][]byte{make([]byte, 16)}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	client, server := net.Pipe()
+	defer server.Close()
+	manager := &statistic.Manager{}
+	conn := method.DialEarlyConn(client, M.Socksaddr{Fqdn: "example.test", Port: 443})
+	tracker := statistic.NewTCPTracker(outbound.NewConn(conn, closeTestAdapter()), manager, &C.Metadata{}, nil, 0, 0, false)
+	readDone := make(chan error, 1)
+	go func() { _, err := tracker.Read(make([]byte, 1)); readDone <- err }()
+	if err := tracker.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-readDone:
+		if err == nil {
+			t.Fatal("SS2022 read succeeded after transport close")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("transport Close did not unblock SS2022 read")
+	}
+	if manager.Get(tracker.ID()) != nil {
+		t.Fatal("tracker was not removed")
+	}
+}
+
+func TestTCPTrackerCloseConcurrentAndError(t *testing.T) {
+	manager := &statistic.Manager{}
+	entered, release := make(chan struct{}), make(chan struct{})
+	closeErr := errors.New("transport close failed")
+	leaf := &closeTestConn{closeFn: func() error { close(entered); <-release; return closeErr }}
+	tracker := statistic.NewTCPTracker(outbound.NewConn(leaf, closeTestAdapter()), manager, &C.Metadata{SmartTarget: "close-test"}, nil, 0, 0, false)
+	var notifications atomic.Int32
+	previousNotify := statistic.DefaultRequestNotify
+	statistic.DefaultRequestNotify = func(statistic.Tracker) { notifications.Add(1) }
+	defer func() { statistic.DefaultRequestNotify = previousNotify }()
+	first := make(chan error, 1)
+	go func() { first <- tracker.Close() }()
+	<-entered
+	var wg sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if err := tracker.Close(); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	done := make(chan struct{})
+	go func() { wg.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Error("duplicate Close blocked on in-progress Close")
+	}
+	close(release)
+	if err := <-first; !errors.Is(err, closeErr) {
+		t.Errorf("first Close error = %v, want %v", err, closeErr)
+	}
+	<-done
+	if leaf.closes.Load() != 1 || notifications.Load() != 1 {
+		t.Errorf("transport closes=%d notifications=%d, want 1 each", leaf.closes.Load(), notifications.Load())
+	}
+	if manager.Get(tracker.ID()) != nil {
+		t.Error("failed transport Close left tracker registered")
+	}
+	manager.RangeSmartTarget("close-test", func(string) bool { t.Error("Smart target membership remains"); return true })
+}
